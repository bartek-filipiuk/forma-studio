# Copy to .env. Keys are only read by API/worker; never use VITE_* for secrets.
FORMA_OPENAI_API_KEY=
# Explicitly choose a Responses API model with structured outputs on your account.
FORMA_OPENAI_MODEL=
FORMA_MESHY_API_KEY=
FORMA_MESHY_MODEL=meshy-7.1
# Compose sets Postgres, Redis and S3. Local Python defaults to SQLite + disk.
# Override with a trusted, pinned MinIO image if the default registry is unavailable.
# FORMA_MINIO_IMAGE=minio/minio@sha256:<verified-digest>
# Choose a free localhost port if 8080 is already used.
FORMA_WEB_PORT=8080
# Single-owner authentication. Set the password interactively with:
# docker compose exec api python -m forma.owner
# For HTTPS deployment, set the browser-facing origin (no path/trailing slash).
# FORMA_PUBLIC_URL=https://forma.example.com
# FORMA_AUTH_COOKIE_SECURE=true
FORMA_SESSION_HOURS=12
# Production: set a strong random value before the first start. Changing it later
# requires changing the password inside the existing Postgres volume.
# FORMA_DB_PASSWORD=
